# ==============================================================================
# DOCOPS ENGINE CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in your project root or skill directory.
# The '.env' file contains local credentials and is ignored by Git for security.

# ------------------------------------------------------------------------------
# 1. PROJECT & DOCUMENT IDENTIFICATION
# ------------------------------------------------------------------------------
PROJECT_NAME="Sample Project"
DOC_TITLE="Technical & Architectural Documentation"
OUTPUT_FILENAME="Technical_Documentation"
BRAND_COLOR="#005BAA"

# ------------------------------------------------------------------------------
# 2. LEAD DEVELOPER / ASSIGNEE METADATA
# ------------------------------------------------------------------------------
DEV_NAME="Developer Name"
DEV_EMAIL="developer@example.com"

# ------------------------------------------------------------------------------
# 3. SMTP SERVER CONFIGURATION (EMAIL ALERTS)
# ------------------------------------------------------------------------------
# Examples:
# - Gmail: smtp.gmail.com (Port 587, use Google App Password)
# - Outlook/Office 365: smtp.office365.com (Port 587)
# - Local Relay / Corporate Server: localhost (Port 25)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=developer@example.com
SMTP_PASSWORD=your_app_password_here

# ------------------------------------------------------------------------------
# 4. RECIPIENTS (STAKEHOLDERS)
# ------------------------------------------------------------------------------
# Comma-separated list of email addresses that will receive doc updates & DOCX attachments
DOC_EMAILS=stakeholder1@example.com,stakeholder2@example.com
